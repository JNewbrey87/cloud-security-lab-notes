<group name="local,">

  <!-- Rule 100002: Windows Failed Logon (Event 4625) -->
  <!-- Fires on every failed Windows logon attempt on any monitored host -->
  <!-- MITRE: T1110 (Brute Force) -->
  <!-- Validated: P1-1a (first deployment); P1-1c (domain-joined jump box, 17 firings including 3 after an agent restart) -->
  <rule id="100002" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4625$</field>
    <description>Custom: Windows failed logon attempt detected (Event 4625)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Rule 100003: SSH Brute Force (3+ failed attempts in 60s from same source IP) -->
  <!-- MITRE: T1110 (Brute Force), T1110.001 (Password Guessing) -->
  <!-- Validated: P2-1b (Hydra against LAB-UBTU SSH service from LAB-KALI) -->
  <!-- Ubuntu 25.04: sshd-session routes auth failures through PAM. -->
  <!--   The dominant brute-force event is rule 2502 ("User missed the password more than one time"), not rule 5700. -->
  <!--   Rule 5700 still fires but less often; keying off 2502 is what makes this rule reliable on 25.04. -->
  <!--   The original Ubuntu 22.04 version of this rule (P1-1b) keyed off the older sshd failure rules. -->
  <!-- Requires "PerSourcePenalties no" in /etc/ssh/sshd_config so attempts reach the auth layer -->
  <!--   (25.04 rate-limits connections before authentication by default, which suppresses all auth logging). -->
  <rule id="100003" level="10" frequency="3" timeframe="60">
    <if_matched_sid>2502</if_matched_sid>
    <same_source_ip />
    <description>Custom: SSH brute force detected: 3+ PAM auth failures in 60 sec from same source IP</description>
    <mitre>
      <id>T1110</id>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!-- Rule 100004: Lateral Movement, Explicit Credential Use Outbound (Event 4648) -->
  <!-- Fires on the SOURCE host when Windows records explicit credential use toward a remote target -->
  <!-- Captures the outbound side of a lateral movement attempt (net use, Invoke-Command, etc.) -->
  <!-- MITRE: T1021.002 (Remote Services: SMB/Windows Admin Shares) -->
  <!-- Validated: P1-1d (net use toward the DC admin share from LAB-WSJP-25, 3 hits) -->
  <rule id="100004" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4648$</field>
    <description>Custom: Explicit credential use toward remote host detected - possible lateral movement (Event 4648)</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

  <!-- Rule 100005: Lateral Movement Arrival, Failed Network Logon on Tier 0 DC (Event 4625, logon type 3) -->
  <!-- Fires on the TARGET DC when an incoming network logon attempt fails -->
  <!-- logonType 3 = network logon; without this filter, failed interactive logons (type 2) also trigger -->
  <!-- Level 14: any network auth attempt reaching the Tier 0 DC is treated as more severe than Tier 1 activity -->
  <!-- MITRE: T1021.002 (Remote Services: SMB/Windows Admin Shares) -->
  <!-- Deployed: P1-1d. Validated live: follow-up session, June 27 2026 (incoming 4625 type 3 on LAB-WSDC-22 from LAB-WSJP-25, NTLM) -->
  <!-- KEY: net use targeting the DC by IP falls back to NTLM (not Kerberos); Event 4771 is NOT generated on this path -->
  <rule id="100005" level="14">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4625$</field>
    <field name="win.eventdata.logonType">^3$</field>
    <description>Custom: Failed network logon on Tier 0 DC - possible lateral movement arrival (Event 4625, logon type 3)</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

  <!-- Rule 100006: Windows New Local User Account Created (Event 4720) -->
  <!-- MITRE: T1136.001 (Create Account: Local Account) -->
  <!-- Catches attacker persistence via account creation on a monitored host -->
  <!-- Added: P2-1b. Not yet fired in a lab. -->
  <rule id="100006" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>Custom: Windows user account created (Event 4720) - possible persistence via local account</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- Rule 100007: New Windows Service Installed (Event 7045) -->
  <!-- MITRE: T1543.003 (Create or Modify System Process: Windows Service) -->
  <!-- Catches service-based persistence or privilege escalation -->
  <!-- Added: P2-1b. Not yet fired in a lab. -->
  <rule id="100007" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^7045$</field>
    <description>Custom: New Windows service installed (Event 7045) - possible persistence or privilege escalation</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
  </rule>

  <!-- Rule 100008: Windows Account Lockout (Event 4740) -->
  <!-- MITRE: T1110 (Brute Force) -->
  <!-- Complements rule 100002 (single failure); 4740 fires once a lockout threshold is crossed -->
  <!-- Added: P2-1b. Not yet fired in a lab. -->
  <rule id="100008" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4740$</field>
    <description>Custom: Windows account lockout detected (Event 4740) - brute force indicator</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Rule 100009: SSH Auth Failure with Remote Host Attribution (Ubuntu 25.04 PAM single-failure format) -->
  <!-- MITRE: T1110 (Brute Force) -->
  <!-- Parent: rule 5711; match: rhost= present in the log line -->
  <!-- Catches the sshd-session single-failure PAM path ("PAM 1 more authentication failure") that carries rhost= -->
  <!-- Diagnostic supplement to rule 2502 (the plural "N more" path that drives rule 100003) on Ubuntu 25.04 -->
  <!-- Added: P2-1b. Not yet fired in a lab. -->
  <rule id="100009" level="5">
    <if_sid>5711</if_sid>
    <match>rhost=</match>
    <description>Custom: SSH auth failure with remote host attribution (PAM format, sshd-session, Ubuntu 25.04)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
